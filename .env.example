# Server Configuration
PORT=8080
NODE_ENV=production

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://taash_user:taash_secure_password_123@localhost:5432/taash_db?schema=public"

# Security Secrets
JWT_SECRET="generate_a_random_64_char_secret_key_here!"

# Docker Postgres Credentials (if using docker-compose)
POSTGRES_USER=taash_user
POSTGRES_PASSWORD=taash_secure_password_123
POSTGRES_DB=taash_db
